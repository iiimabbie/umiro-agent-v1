{
  "name": "umiro",
  "version": "0.1.0",
  "description": "Self-hosted personal AI assistant with an OpenAI-compatible agent loop",
  "main": "dist/index.js",
  "bin": {
    "umiro": "./bin/umiro.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "attachment-gc": "tsx scripts/attachment-gc.ts",
    "test": "UMIRO_CONFIG_PATH=tests/fixtures/config.yaml tsx --test --test-concurrency=2 tests/*.test.ts scripts/test-{openai,llm}-*.ts",
    "embed-status": "tsx scripts/embed-status.ts"
  },
  "keywords": [],
  "author": "iiimabbie",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "googleapis": "^171.4.0",
    "node-cron": "^4.2.1",
    "officeparser": "^7.8.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer-core": "^25.0.3",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "pdfjs-dist": "6.3.289",
    "qs": "6.16.0"
  }
}
